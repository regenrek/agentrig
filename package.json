{
  "name": "agentrig-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "registry:build": "tsx scripts/build-registry.ts",
    "plugins:build": "pnpm -C packages/cli dev -- pack plugin export --agent all",
    "plugins:build:claude": "pnpm -C packages/cli dev -- pack plugin export --agent claude",
    "dev:cli": "pnpm -C packages/cli dev",
    "test": "pnpm -C packages/cli test",
    "test:run": "pnpm -C packages/cli test:run",
    "test:e2e:run": "pnpm -C packages/cli test:e2e:run",
    "test:release:local": "node scripts/test-release-local.mjs",
    "test:release:smoke": "node scripts/test-release-local.mjs --smoke-only",
    "coverage": "pnpm -C packages/cli coverage",
    "build:cli": "pnpm -C packages/cli build",
    "docs:dev": "pnpm -C apps/docs dev",
    "docs:build": "pnpm -C apps/docs build",
    "playground:vite:check": "node scripts/vite-playground.mjs --check",
    "playground:vite:refresh": "node scripts/vite-playground.mjs --write",
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "prepare": "lefthook install",
    "security:check": "./scripts/secleak-check.sh",
    "security:hooks": "node scripts/hooks/block-forbidden-staged-files.mjs"
  },
  "devDependencies": {
    "lefthook": "^2.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
