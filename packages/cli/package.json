{
  "name": "agentrig",
  "version": "0.1.0",
  "description": "Compose and apply AI agent skills/workflows via packs and registries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/regenrek/agentrig"
  },
  "type": "module",
  "bin": {
    "agentrig": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
