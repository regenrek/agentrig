    "test:run": "vitest --run",
    "coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "giget": "^1.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
