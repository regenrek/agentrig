{
  "name": "agentrig",
  "version": "0.2.2",
  "description": "Compose and apply AI agent skills/workflows via packs and registries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/regenrek/agentrig"
  },
  "type": "module",
  "bin": {
    "agentrig": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
