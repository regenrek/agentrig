{
  "name": "agentrig",
  "version": "0.8.2",
  "description": "Compose and apply AI agent skills/workflows via plugins and registries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/regenrek/agentrig"
  },
  "type": "module",
  "bin": {
    "agentrig": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "vp pack",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test",
    "test:run": "vp test --run",
    "coverage": "vp test --run --coverage",
    "test:e2e:run": "vp pack && vp test --run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26",
    "citty": "^0.2.2",
    "giget": "^3.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@agentrig/sdk": "workspace:^0.1.4",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "^0.1.22"
  },
  "engines": {
    "node": ">=18"
  }
}
