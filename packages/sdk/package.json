{
  "name": "@agentrig/sdk",
  "version": "0.1.0",
  "description": "Runtime-neutral AgentRig scanner, provider, and enrichment contracts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/regenrek/agentrig"
  },
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./fs-adapters/local-fs": {
      "types": "./dist/fs-adapters/local-fs.d.mts",
      "import": "./dist/fs-adapters/local-fs.mjs"
    },
    "./fs-adapters/zip-tree": {
      "types": "./dist/fs-adapters/zip-tree.d.mts",
      "import": "./dist/fs-adapters/zip-tree.mjs"
    },
    "./fs-adapters/tar-tree": {
      "types": "./dist/fs-adapters/tar-tree.d.mts",
      "import": "./dist/fs-adapters/tar-tree.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vp test",
    "test:run": "vp test --run"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "^0.1.14"
  },
  "engines": {
    "node": ">=18"
  }
}
