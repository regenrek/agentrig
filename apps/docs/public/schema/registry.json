{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentrig.ai/schema/registry.json",
  "title": "agentrig Registry",
  "description": "Schema for agentrig registry index file",
  "type": "object",
  "required": ["name", "items"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "name": {
      "type": "string",
      "description": "Name of the registry",
      "minLength": 1,
      "maxLength": 64
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "description": "Homepage URL of the registry"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the registry was generated"
    },
    "items": {
      "type": "array",
      "description": "List of packs in the registry",
      "items": {
        "type": "object",
        "required": ["name", "title", "description", "meta"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique pack identifier",
            "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$"
          },
          "title": {
            "type": "string",
            "description": "Human-readable title"
          },
          "description": {
            "type": "string",
            "description": "Brief description of the pack"
          },
          "version": {
            "type": "string",
            "description": "Semantic version",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Tags for categorization"
          },
          "topics": {
            "type": "object",
            "description": "Structured topics for categorization",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "meta": {
            "type": "string",
            "description": "Relative path to the pack JSON file"
          }
        }
      }
    }
  }
}
