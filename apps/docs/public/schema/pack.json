{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agentrig.ai/schema/pack.json",
  "title": "agentrig Pack",
  "description": "Schema for agentrig pack definition file",
  "type": "object",
  "required": ["name", "title", "description", "version", "files"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "kind": {
      "type": "string",
      "enum": ["agentrig:pack"],
      "default": "agentrig:pack",
      "description": "Pack type identifier"
    },
    "name": {
      "type": "string",
      "description": "Unique pack identifier",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$|^[a-z0-9]$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the pack"
    },
    "version": {
      "type": "string",
      "description": "Semantic version",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
    },
    "author": {
      "type": "string",
      "description": "Pack author or organization"
    },
    "license": {
      "type": "string",
      "description": "SPDX license identifier"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tags for categorization"
    },
    "topics": {
      "type": "object",
      "description": "Structured topics for categorization",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "rigDependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other packs this pack depends on (can be names, @namespace/name, or URLs)"
    },
    "files": {
      "type": "array",
      "description": "Files to install",
      "items": {
        "type": "object",
        "required": ["path", "target"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Source path in the registry"
          },
          "target": {
            "type": "string",
            "description": "Target path in the project (supports {{skillsDir}} placeholder)"
          },
          "mode": {
            "type": "string",
            "pattern": "^[0-7]{3}$",
            "description": "Unix file permissions (e.g., 755)"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA256 hash of the file content"
          }
        }
      }
    }
  }
}
