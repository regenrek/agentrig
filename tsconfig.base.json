{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "paths": {
      "@agentrig/sdk": [
        "./packages/sdk/src/index.ts"
      ],
      "@agentrig/sdk/fs-adapters/local-fs": [
        "./packages/sdk/src/fs-adapters/local-fs.ts"
      ],
      "@agentrig/sdk/fs-adapters/zip-tree": [
        "./packages/sdk/src/fs-adapters/zip-tree.ts"
      ]
    },
    "types": [],
    "noEmit": true
  }
}
